# Deploy-side toolchain for the App Engine gen2 (java21) runtime.
#
# This is deliberately separate from akvo/akvo-flow-builder. That image pins JDK 8,
# node 12 and lein, and it must stay that way: the DataNucleus 3.1.3 enhancer wants
# Java 8 bytecode, and the Dashboard build is wired to its node toolchain. Only the
# deploy step needs to be modern, so only the deploy step moves.
#
# `gcloud app deploy` does its own staging for appengine-web.xml applications, which
# is why appengine-maven-plugin is not on the critical path at all.
FROM google/cloud-sdk:581.0.0

# The Debian image installs gcloud from apt and disables the component manager,
# so the Java staging component comes from apt as well.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        default-jre-headless \
        google-cloud-cli-app-engine-java \
    && rm -rf /var/lib/apt/lists/*
